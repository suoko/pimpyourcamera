      "portra400": {
        "base": "Photo Style: Natural / Flat",
        "settings": {
          "Contrast": "-2",
          "Highlight": "-1",
          "Shadow": "+1",
          "Saturation": "+1",
          "Hue": "+1",
          "Sharpness": "-2",
          "Noise Reduction": "-2"
        },
        "note": "Warm neutral tones with soft, lifted shadow response."
      },
      "tri-x400": {
        "base": "Photo Style: L.Monochrome / Monochrome",
