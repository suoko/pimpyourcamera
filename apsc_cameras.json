  "emulationRules": {
    "Sony": {
      "sony_a7c_color": {
        "base": "Picture Profile: PP2 or PP6",
        "settings": {
          "Black Level": "-10",
          "Gamma": "Cine4",
          "Black Gamma": "Range: Wide / Level: -1",
          "Knee": "Mode: Manual / Point: 100% / Slope: 0",
          "Color Mode": "Pro",
          "Saturation": "-2",
          "Color Phase": "-1 or -2",
          "Color Depth R": "+3",
          "Color Depth G": "+1",
          "Color Depth B": "-1",
          "Color Depth C": "-1",
          "Color Depth M": "-1",
          "Color Depth Y": "+1",
          "Detail / Sharpening": "-5",
          "WB Grid Shift": "A1 to A2 (Amber) / M0.5 to M1 (Magenta)"
        },
        "note": "Mimics the smooth highlight roll-off, soft skin tones, and corrected greenish-yellow hue shift of the newer Sony A7C color science on older sensors like the a6400."
      },
      "portra400": {
        "base": "Creative Look: IN / Portrait",
        "settings": {
          "Contrast": "-2",
          "Highlights": "-1",
          "Shadows": "+1",
          "Fade": "+1",
          "Saturation": "0",
          "WB Shift": "A-B: B1.0, G-M: M0.5"
        },
        "note": "Use 'IN' look on newer models or 'Portrait' on older bodies."
      }
    },
    "Fujifilm": {
      "portra400": {
        "base": "Classic Chrome",
        "settings": {
          "Dynamic Range": "DR400",
          "Grain Effect": "Weak, Small",
          "Color Chrome FX": "Strong",
          "White Balance": "Auto R:+2 B:-4",
          "Highlight": "-1",
          "Shadow": "-1",
          "Color": "+1",
          "Sharpness": "-2"
        },
        "note": "Overexpose +1/3 to +2/3 stop."
      }
    },
    "Canon": {
      "portra400": {
        "base": "Picture Style: Neutral",
        "settings": {
          "Sharpness": "2",
          "Contrast": "-2",
          "Saturation": "+1",
          "Color Tone": "+1",
          "WB Shift": "A2, G1"
        },
        "note": "Flattens initial response before shifting warmth."
      }
    }
  }
