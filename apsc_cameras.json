  "quickCustomInstructions": {
    "title": "Quick Guide: How to Save Custom Presets on APS-C Cameras",
    "Fujifilm": "Menu → Edit/Save Custom Setting → Choose C1–C7 → Configure Film Simulation, Grain, Tone Curve, & WB Shift → Save.",
    "Sony": "Set Exposure Mode → Menu → Shooting → Memory / [MR Camera Set] → Save to Memory Slot 1, 2, or 3.",
    "Canon": "Dial in Picture Style & WB → Menu → Setup Menu (Wrench) → [Custom Shooting Mode (C1-C3)] → Register Settings.",
    "Nikon": "Configure Picture Control & WB → Menu → Setup Menu → Save User Settings → Choose U1, U2, or U3."
  },
